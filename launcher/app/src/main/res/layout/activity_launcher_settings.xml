<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings in this fork's card look: sections of cards, flat in one LinearLayout. LauncherSettingsActivity
     gives every row its chip, chevron and second line (CardStyle); the 20sp captions sit in group cards with their
     pills in the next sibling. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="34sp" />

        <TextView style="@style/SettingsSection" android:text="@string/section_appearance" />

        <TextView
            android:id="@+id/themeChoice"
            style="@style/SettingsRow"
            android:text="@string/theme_label" />

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:text="@string/wallpaper_label" />

        <LinearLayout style="@style/SettingsGroup">

            <TextView
                android:id="@+id/clockCaption"
                style="@style/SettingsCaption"
                android:text="@string/dream_name"
                android:textSize="20sp" />

            <LinearLayout style="@style/SettingsPills">
                <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SettingsSection" android:text="@string/section_dock" />

        <TextView
            android:id="@+id/dockEditChoice"
            style="@style/SettingsRow"
            android:text="@string/dock_edit" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:text="@string/reorder" />

        <LinearLayout style="@style/SettingsGroup">

            <TextView
                android:id="@+id/columnsCaption"
                style="@style/SettingsCaption"
                android:text="@string/columns_label"
                android:textSize="20sp" />

            <LinearLayout style="@style/SettingsPills">
                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SettingsGroup">

            <TextView
                android:id="@+id/rowsCaption"
                style="@style/SettingsCaption"
                android:text="@string/rows_below_dock_label"
                android:textSize="20sp" />

            <LinearLayout style="@style/SettingsPills">
                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SettingsGroup">

            <TextView
                android:id="@+id/dockOpacityCaption"
                style="@style/SettingsCaption"
                android:text="@string/dock_opacity_label"
                android:textSize="20sp" />

            <LinearLayout style="@style/SettingsPills">
                <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:text="@string/open_on_start_label"
            android:visibility="gone" />

        <TextView style="@style/SettingsSection" android:text="@string/section_advanced" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:text="@string/animations_label" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:text="@string/advanced_effects" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/advanced_effects_warning"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:text="@string/follow_theme" />

        <TextView style="@style/SettingsSection" android:text="@string/section_system" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:text="@string/home_settings" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:text="@string/tv_settings" />

        <TextView
            android:id="@+id/stockLauncherChoice"
            style="@style/SettingsRow"
            android:text="@string/stock_return_label" />

        <TextView style="@style/SettingsSection" android:text="@string/section_update" />

        <TextView
            android:id="@+id/updateChoice"
            style="@style/SettingsRow"
            android:text="@string/update_check" />
    </LinearLayout>
</ScrollView>
